{
  "manifest_version": 3,
  "name": "Fidolizer",
  "version": "1.0.0",
  "description": "Routes Chrome WebAuthn create and get to the fidolizer authenticator.",
  "key": "",
  "permissions": ["webAuthenticationProxy", "nativeMessaging", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["origin.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
